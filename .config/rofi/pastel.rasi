/* Launcher look modelled on the reference setup: a dark translucent rounded
 * panel floating centre-screen, icon grid, soft accent on the selection.
 *
 * Colours come from pywal via the import below, so the launcher recolours
 * with the wallpaper like the rest of the rice. rofi re-reads this on every
 * launch, so there's no daemon to poke on a wallpaper change.
 */
@import "~/.cache/wal/colors-rofi-dark.rasi"
@import "~/.cache/wal/colors-rofi-alpha.rasi"

* {
    font:             "FiraCode Nerd Font 11";
    text-color:       @foreground;
    background-color: transparent;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    anchor:           center;
    width:            760px;
    border-radius:    18px;
    background-color: @bg-trans;
    padding:          22px;
    children:         [ inputbar, listview ];
}

/* ── search row ─────────────────────────────────────────────── */
inputbar {
    spacing:          10px;
    padding:          10px 14px;
    margin:           0 0 16px 0;
    border-radius:    12px;
    background-color: @field-bg;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @foreground;
    vertical-align:   0.5;
}

entry {
    placeholder:      "Search…";
    placeholder-color: @foreground;
    vertical-align:   0.5;
}

/* ── icon grid ──────────────────────────────────────────────── */
listview {
    columns:          4;
    lines:            3;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    spacing:          8px;
    cycle:            true;
    scrollbar:        false;
}

element {
    orientation:      vertical;
    padding:          14px 6px;
    spacing:          8px;
    border-radius:    14px;
}

element-icon {
    size:             46px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       inherit;
}

element normal.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @selected-normal-background;
    text-color:       @foreground;
}

element alternate.normal {
    background-color: transparent;
}
