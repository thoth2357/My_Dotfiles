font-family = Fantasque Sans Mono
font-family = FiraCode Nerd Font
font-size = 12

copy-on-select = clipboard
focus-follows-mouse = true
mouse-hide-while-typing = true
shell-integration-features = no-cursor,sudo,no-title

# Room to breathe — text sits well inside the rounded corners instead of
# running up against them.
window-padding-x = 24
window-padding-y = 16
window-padding-balance = true

# Glass: ghostty tints its own background; text/glyphs stay fully opaque.
# Hyprland's blur shows through, and a window rule exempts ghostty from the
# compositor's inactive fade so text never washes out.
# 0.4 washed out badly once the wallpaper went pastel/bright — the reference
# setup reads as a *dark* pane floating over the wallpaper, not a tint of it.
# This is the main taste dial: lower = glassier, higher = more readable.
background-opacity = 0.78
background-blur = 20

# ── Doki Theme "KonoSuba: Darkness" — matches VS Code ──────────────
# Source: unthrottled.doki-theme/generatedThemes/Darkness Dark.theme.json
# NOTE: this is now the *fallback* palette. The wal include at the bottom of
# this file is loaded after it and wins whenever it exists. Comment that
# include out to go back to a terminal that matches the editor.
background = #0a0904
foreground = #F8F8F2
cursor-color = #e99745
selection-background = #553919
selection-foreground = #F8F8F2

# normal 0-7 (black derived from bg, 1-6 straight from the theme)
palette = 0=#21201a
palette = 1=#E356A7
palette = 2=#42E66C
palette = 3=#EFA554
palette = 4=#9B6BDF
palette = 5=#E64747
palette = 6=#75D7EC
palette = 7=#F8F8F2
# brights 8-15 (theme-colors lightened ~15%)
palette = 8=#5a564a
palette = 9=#F576BE
palette = 10=#6BF08D
palette = 11=#F7BE7E
palette = 12=#B48CEA
palette = 13=#F06A6A
palette = 14=#9AE4F2
palette = 15=#FFFFFF

# ── Wallpaper-driven palette (pywal) ───────────────────────────────
# Regenerated by ~/.config/waypaper/wal-ghostty.sh on every wallpaper
# change, which then SIGUSR2s ghostty to reload. Included last so it
# overrides the Doki block above; the leading `?` makes it optional, so
# a cleared ~/.cache still starts cleanly on the fallback.
config-file = ?~/.cache/wal/colors-ghostty.conf
