# Work tree for the dotfiles bare repo is $HOME, so deny everything by default
# and allow-list only what is tracked. Without this, a careless `config add -A`
# would stage the entire home directory — including credentials.
/*
!/.gitignore
!/README.md
!/.bashrc
!/.zshrc
!/.gtkrc-2.0

!/.config
/.config/*
!/.config/hypr
!/.config/waybar
!/.config/swaync
!/.config/fish
!/.config/ghostty
!/.config/rofi
!/.config/wlogout
!/.config/waypaper
!/.config/gtk-3.0
!/.config/gtk-4.0
!/.config/qt5ct
!/.config/qt6ct
!/.config/starship.toml

# pywal: only the templates are source; ~/.cache/wal output is generated
!/.config/wal
/.config/wal/*
!/.config/wal/templates

# clipboard manager: the config, never the history database
!/.config/cursor-clip
/.config/cursor-clip/*
!/.config/cursor-clip/config.toml

# Masks /etc/xdg/autostart/nm-applet.desktop (Hidden=true). Narrow on purpose:
# autostart entries are per-app, so allow the file, not the directory.
!/.config/autostart
/.config/autostart/*
!/.config/autostart/nm-applet.desktop

# syncthing-gtk: autostart_daemon=0 / autokill_daemon=0 so the tray attaches to
# the daemon hyprland.lua starts instead of spawning a second one (and killing
# the real one on exit). Losing this on a restore is a real bug, so track it.
!/.config/syncthing-gtk
/.config/syncthing-gtk/*
!/.config/syncthing-gtk/config.json

# Claude Code: ONLY these two files. Never unignore /.claude broadly —
# .claude/projects/ holds full session transcripts and .claude/.../memory/
# holds working notes. Neither belongs in a public repo.
!/.claude
/.claude/*
!/.claude/settings.json
!/.claude/statusline-command.sh

# --- never, even inside allowed directories -------------------------------
*.bak
*.bak-*
*.leyzs.bak
__pycache__/
*.pyc
.mypy_cache/

# generated by pywal into ~/.cache and symlinked here
/.config/hypr/hyprtoolkit.conf

# comments reference work-internal names; kept local only
/.config/waybar/scripts/cluster.sh
/.config/waybar/scripts/tailscale.sh

# dead: superseded by cluster.sh (which is not tracked); nothing references it
/.config/waybar/scripts/kubectx.sh
